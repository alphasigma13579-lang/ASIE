# ASIE production deployment template.
# Copy to .env.production on the VPS, chmod 600, and insert real values there.
# Never commit the populated file.

ASIE_ENV=production
ASIE_DOMAIN=asie.example.com
ASIE_ALLOWED_ORIGINS=https://asie.example.com
ASIE_API_PORT=8794
ASIE_DB_PATH=/var/lib/asie/asie_local.sqlite3
ASIE_DIB_DB_PATH=/var/lib/asie/dib_local.sqlite3
ASIE_PDF_RENDERER=/usr/bin/chromium
ASIE_STRICT_OPEN_DATA_PROFILE=strict_open_data_only_v1

# External access remains fail-closed until the operator intentionally enables it.
ASIE_ALLOW_EXTERNAL_FETCH=false
ASIE_EXTERNAL_ALLOWED_HOSTS=api.deepseek.com,api.tavily.com,geocode.googleapis.com,places.googleapis.com,maps.googleapis.com,api.pinecone.io,*.pinecone.io
ASIE_EXTERNAL_TIMEOUT_SECONDS=15
ASIE_EXTERNAL_MAX_RESPONSE_BYTES=4194304
ASIE_EXTERNAL_MIN_INTERVAL_SECONDS=1
ASIE_EXTERNAL_USER_AGENT=ASIE-Governed-Acquisition/1.0
ASIE_EXTERNAL_ROBOTS_FAILURE_MODE=deny

# DeepSeek — governed narrative/reasoning only.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=30

# Tavily — source discovery, search, extract, map, and governed crawl.
TAVILY_API_KEY=
TAVILY_PROJECT=
TAVILY_SEARCH_DEPTH=basic

# Google Maps Platform — use separate restricted keys for server and browser.
# Restrict GOOGLE_MAPS_API_KEY by server IP; never expose it to the frontend build.
GOOGLE_MAPS_API_KEY=
# Restrict the browser key by the beta HTTPS referrer. Browser keys are visible by design.
VITE_GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAP_ID=
GOOGLE_MAPS_REGION=SA
GOOGLE_MAPS_LANGUAGE=ar

# Pinecone — existing knowledge index supplied for ASIE.
# Runtime APIs discover the index host through Describe Index; do not hard-code it.
PINECONE_API_KEY=
PINECONE_INDEX=vision2030-kb
PINECONE_API_VERSION=2026-04
PINECONE_EMBED_MODEL=multilingual-e5-large
PINECONE_NAMESPACE_PREFIX=asie

# TLS / Caddy.
ASIE_TLS_EMAIL=

# Deployment controls used by GitHub Actions / VPS scripts.
ASIE_DEPLOY_PATH=/opt/asie
ASIE_BACKUP_RETENTION_DAYS=14

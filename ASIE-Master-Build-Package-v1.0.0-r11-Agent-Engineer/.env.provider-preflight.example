# FC20-03 provider-preflight template. Values remain empty in Git.
# Store real test credentials only as GitHub Environment secrets in
# the protected `provider-preflight` environment.

ASIE_PROVIDER_SECRET_STORE_BACKEND=github_environment
ASIE_PROVIDER_PREFLIGHT_NETWORK_AUTHORIZED=false

DEEPSEEK_API_KEY=
TAVILY_API_KEY=
GOOGLE_MAPS_API_KEY=
PINECONE_API_KEY=

TAVILY_PROJECT=
GOOGLE_MAP_ID=

# These are non-secret defaults. They do not enable network access.
DEEPSEEK_MODEL=deepseek-v4-flash
GOOGLE_MAPS_REGION=SA
GOOGLE_MAPS_LANGUAGE=ar
PINECONE_INDEX=vision2030-kb
PINECONE_API_VERSION=2026-04
PINECONE_EMBED_MODEL=multilingual-e5-large
PINECONE_NAMESPACE_PREFIX=asie


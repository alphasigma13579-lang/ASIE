  "rules": {
    "api_path": "lowercase kebab-case path segments under /api; identifiers are path parameters",
    "http_method": "method is part of endpoint identity",
    "sealed_output_key": "internal immutable Snapshot assembly key; never exposed as a public semantic name without an explicit mapping",
    "public_projection_key": "stable public field read by API, TypeScript, reports, or UI",
    "breaking_policy": "do not rename active paths, sealed output keys, or public projection keys in place; add a versioned migration"
  },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asie.local/schemas/finance/finance-simulation-distribution-profile.v1.schema.json",
  "title": "ASIE Finance Simulation Distribution Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "version",
    "content_hash",
    "status",
    "currency",
    "archetype_ref",
    "target_contract_version",
    "variables",
    "review",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "finance-simulation-distribution-profile.v1"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^fdp_[A-Za-z0-9_-]{4,100}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "draft",
        "calibrated",
        "finance_reviewed",
        "sector_reviewed",
        "approved"
      ]
    },
    "archetype_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archetype_id",
        "version",
        "registry_hash"
      ],
      "properties": {
        "archetype_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "registry_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "target_contract_version": {
      "const": "finance-model-input.v2"
    },
    "variables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variable_id",
          "target_ref",
          "operation",
          "unit",
          "distribution",
          "bounds",
          "calibration"
        ],
        "properties": {
          "variable_id": {
            "type": "string",
            "pattern": "^var_[A-Za-z0-9_-]{1,80}$"
          },
          "target_ref": {
            "type": "string",
            "pattern": "^(?:\\$\\.revenue_streams\\[[A-Za-z0-9_-]{1,84}\\]\\.(?:volume_series|price_series|variable_cost_series|capacity_series)\\[(?:\\*|[0-9]{4}-(?:0[1-9]|1[0-2]))\\]\\.value|\\$\\.operating_costs\\[[A-Za-z0-9_-]{1,84}\\]\\.schedule\\[(?:\\*|[0-9]{4}-(?:0[1-9]|1[0-2]))\\]\\.value|\\$\\.capex_assets\\[[A-Za-z0-9_-]{1,84}\\]\\.(?:cost|residual_value)|\\$\\.working_capital\\.(?:dso_days|dio_days|dpo_days)|\\$\\.valuation_policy\\.(?:discount_rate_annual|finance_rate_annual|reinvestment_rate_annual)|\\$\\.financing\\.debt_tranches\\[[A-Za-z0-9_-]{1,84}\\]\\.annual_rate)$",
            "maxLength": 200
          },
          "operation": {
            "enum": [
              "replace",
              "multiply",
              "add"
            ]
          },
          "unit": {
            "enum": [
              "money",
              "units",
              "count",
              "days",
              "rate",
              "ratio",
              "multiplier"
            ]
          },
          "distribution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "parameters"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "triangular",
                  "uniform",
                  "normal_truncated",
                  "lognormal_truncated",
                  "discrete_empirical"
                ]
              },
              "parameters": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "minimum": {
                    "type": "string",
                    "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
                  },
                  "maximum": {
                    "type": "string",
                    "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
                  },
                  "mode": {
                    "type": "string",
                    "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
                  },
                  "mean": {
                    "type": "string",
                    "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
                  },
                  "stddev": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
                  },
                  "mu": {
                    "type": "string",
                    "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
                  },
                  "sigma": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
                  },
                  "values": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 500,
                    "items": {
                      "type": "string",
                      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
                    }
                  },
                  "probabilities": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 500,
                    "items": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
                    }
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "triangular"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "parameters": {
                      "required": [
                        "minimum",
                        "mode",
                        "maximum"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "uniform"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "parameters": {
                      "required": [
                        "minimum",
                        "maximum"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "normal_truncated"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "parameters": {
                      "required": [
                        "mean",
                        "stddev",
                        "minimum",
                        "maximum"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "lognormal_truncated"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "parameters": {
                      "required": [
                        "mu",
                        "sigma",
                        "minimum",
                        "maximum"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "discrete_empirical"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "parameters": {
                      "required": [
                        "values",
                        "probabilities"
                      ]
                    }
                  }
                }
              }
            ]
          },
          "bounds": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minimum",
              "maximum"
            ],
            "properties": {
              "minimum": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
              },
              "maximum": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
              }
            }
          },
          "calibration": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "sample_size",
              "period_from",
              "period_to",
              "geography",
              "freshness_as_of",
              "data_source_refs",
              "lineage"
            ],
            "properties": {
              "method": {
                "enum": [
                  "historical_empirical",
                  "benchmark_reviewed",
                  "expert_elicitation_reviewed",
                  "hybrid_reviewed"
                ]
              },
              "sample_size": {
                "type": "integer",
                "minimum": 0
              },
              "period_from": {
                "type": "string",
                "format": "date"
              },
              "period_to": {
                "type": "string",
                "format": "date"
              },
              "geography": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "freshness_as_of": {
                "type": "string",
                "format": "date"
              },
              "data_source_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "lineage": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "assumption_refs",
                  "evidence_refs"
                ],
                "properties": {
                  "assumption_refs": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    }
                  },
                  "evidence_refs": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_roles",
        "approvals"
      ],
      "properties": {
        "required_roles": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "finance_reviewer",
              "sector_expert",
              "quantitative_reviewer",
              "qa",
              "security"
            ]
          }
        },
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "reviewer_ref",
              "status",
              "reviewed_at",
              "evidence_ref"
            ],
            "properties": {
              "role": {
                "enum": [
                  "finance_reviewer",
                  "sector_expert",
                  "quantitative_reviewer",
                  "qa",
                  "security"
                ]
              },
              "reviewer_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "status": {
                "enum": [
                  "approved",
                  "rejected"
                ]
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_ref",
        "effective_from",
        "created_at"
      ],
      "properties": {
        "owner_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "effective_from": {
          "type": "string",
          "format": "date"
        },
        "expires_at": {
          "type": "string",
          "format": "date"
        },
        "supersedes_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    }
  }
}

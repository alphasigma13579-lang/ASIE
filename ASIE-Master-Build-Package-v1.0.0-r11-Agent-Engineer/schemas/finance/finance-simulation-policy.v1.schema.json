{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asie.local/schemas/finance/finance-simulation-policy.v1.schema.json",
  "title": "ASIE Finance Simulation Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "content_hash",
    "status",
    "rng",
    "iterations",
    "convergence",
    "outputs",
    "review",
    "metadata",
    "lineage"
  ],
  "properties": {
    "schema_version": {
      "const": "finance-simulation-policy.v1"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^fsp_[A-Za-z0-9_-]{4,100}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "draft",
        "calibrated",
        "finance_reviewed",
        "sector_reviewed",
        "approved"
      ]
    },
    "rng": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "stream_derivation",
        "reference_vector_ref"
      ],
      "properties": {
        "algorithm": {
          "const": "pcg64_dxsm_v1"
        },
        "stream_derivation": {
          "const": "seed_scenario_variable_v1"
        },
        "reference_vector_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "iterations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum",
        "batch_size"
      ],
      "properties": {
        "minimum": {
          "type": "integer",
          "minimum": 100,
          "maximum": 100000
        },
        "maximum": {
          "type": "integer",
          "minimum": 100,
          "maximum": 100000
        },
        "batch_size": {
          "type": "integer",
          "minimum": 50,
          "maximum": 10000
        }
      }
    },
    "convergence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monitored_metrics",
        "quantiles",
        "relative_tolerance",
        "absolute_tolerance",
        "minimum_batches",
        "stable_batches",
        "failure_policy"
      ],
      "properties": {
        "monitored_metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "npv_unlevered",
              "irr_unlevered",
              "funding_need",
              "dscr_min",
              "llcr"
            ]
          }
        },
        "quantiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "0.10",
              "0.50",
              "0.90"
            ]
          }
        },
        "relative_tolerance": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
        },
        "absolute_tolerance": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
        },
        "minimum_batches": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1000
        },
        "stable_batches": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        },
        "failure_policy": {
          "const": "not_ready"
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_ids",
        "quantiles",
        "probability_thresholds"
      ],
      "properties": {
        "metric_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "npv_unlevered",
              "irr_unlevered",
              "mirr_unlevered",
              "payback_months",
              "funding_need",
              "dscr_min",
              "llcr"
            ]
          }
        },
        "quantiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "0.01",
              "0.05",
              "0.10",
              "0.25",
              "0.50",
              "0.75",
              "0.90",
              "0.95",
              "0.99"
            ]
          }
        },
        "probability_thresholds": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric_id",
              "operator",
              "value"
            ],
            "properties": {
              "metric_id": {
                "type": "string"
              },
              "operator": {
                "enum": [
                  "lt",
                  "lte",
                  "gt",
                  "gte"
                ]
              },
              "value": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,8})?$"
              }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_roles",
        "approvals"
      ],
      "properties": {
        "required_roles": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "finance_reviewer",
              "sector_expert",
              "quantitative_reviewer",
              "qa",
              "security"
            ]
          }
        },
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "reviewer_ref",
              "status",
              "reviewed_at",
              "evidence_ref"
            ],
            "properties": {
              "role": {
                "enum": [
                  "finance_reviewer",
                  "sector_expert",
                  "quantitative_reviewer",
                  "qa",
                  "security"
                ]
              },
              "reviewer_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "status": {
                "enum": [
                  "approved",
                  "rejected"
                ]
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_ref",
        "effective_from",
        "created_at"
      ],
      "properties": {
        "owner_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "effective_from": {
          "type": "string",
          "format": "date"
        },
        "expires_at": {
          "type": "string",
          "format": "date"
        },
        "supersedes_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assumption_refs",
        "evidence_refs"
      ],
      "properties": {
        "assumption_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    }
  }
}
